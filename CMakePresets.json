{
  "$schema": "https://raw.githubusercontent.com/Kitware/CMake/master/Help/manual/presets/schema.json",
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "warnings": {
        "dev": true,
        "deprecated": true
      },
      "cacheVariables": {
        "EMPIRE_BUILD_APP": "ON",
        "EMPIRE_BUILD_TESTS": "ON",
        "EMPIRE_WARNINGS_AS_ERRORS": "OFF",
        "EMPIRE_ENGINE_INSTALL": "OFF"
      }
    },

    {
      "name": "windows-vs-base",
      "hidden": true,
      "inherits": "base",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "$env{VSINSTALLDIR}Common7/IDE/CommonExtensions/Microsoft/CMake/cmake/Microsoft/SegmentHeap.cmake"
      }
    },

    {
      "name": "vs2026-base",
      "hidden": true,
      "inherits": "windows-vs-base",
      "generator": "Visual Studio 18 2026"
    },
    {
      "name": "vs2026-x64-base",
      "hidden": true,
      "inherits": "vs2026-base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "vs2026-x64-debug",
      "displayName": "VS 2026 · x64 · Debug",
      "inherits": "vs2026-x64-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "vs2026-x64-release",
      "displayName": "VS 2026 · x64 · Release",
      "inherits": "vs2026-x64-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "vs2026-x64-relwithdebinfo",
      "displayName": "VS 2026 · x64 · RelWithDebInfo",
      "inherits": "vs2026-x64-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "vs2026-x86-base",
      "hidden": true,
      "inherits": "vs2026-base",
      "architecture": {
        "value": "x86",
        "strategy": "external"
      }
    },
    {
      "name": "vs2026-x86-debug",
      "displayName": "VS 2026 · x86 · Debug",
      "inherits": "vs2026-x86-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "vs2026-x86-release",
      "displayName": "VS 2026 · x86 · Release",
      "inherits": "vs2026-x86-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },

    {
      "name": "vs2022-base",
      "hidden": true,
      "inherits": "windows-vs-base",
      "generator": "Visual Studio 17 2022"
    },
    {
      "name": "vs2022-x64-base",
      "hidden": true,
      "inherits": "vs2022-base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "vs2022-x64-debug",
      "displayName": "VS 2022 · x64 · Debug (legacy)",
      "inherits": "vs2022-x64-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "vs2022-x64-release",
      "displayName": "VS 2022 · x64 · Release (legacy)",
      "inherits": "vs2022-x64-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "vs2022-x64-relwithdebinfo",
      "displayName": "VS 2022 · x64 · RelWithDebInfo (legacy)",
      "inherits": "vs2022-x64-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "vs2022-x86-base",
      "hidden": true,
      "inherits": "vs2022-base",
      "architecture": {
        "value": "x86",
        "strategy": "external"
      }
    },
    {
      "name": "vs2022-x86-debug",
      "displayName": "VS 2022 · x86 · Debug (legacy)",
      "inherits": "vs2022-x86-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "vs2022-x86-release",
      "displayName": "VS 2022 · x86 · Release (legacy)",
      "inherits": "vs2022-x86-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },

    {
      "name": "windows-ninja-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "ninja-msvc-debug",
      "displayName": "Ninja · MSVC · Debug   (run from x64 Native Tools)",
      "inherits": "windows-ninja-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "ninja-msvc-release",
      "displayName": "Ninja · MSVC · Release (run from x64 Native Tools)",
      "inherits": "windows-ninja-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },

    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux · GCC · Debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux · GCC · Release",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux · Clang · Debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-clang-release",
      "displayName": "Linux · Clang · Release",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },

    {
      "name": "macos-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "macos-arm64-debug",
      "displayName": "macOS · arm64 · Debug",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-arm64-release",
      "displayName": "macOS · arm64 · Release",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },

    {
      "name": "ci-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "EMPIRE_BUILD_APP": "ON",
        "EMPIRE_BUILD_TESTS": "ON",
        "EMPIRE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ci-windows",
      "displayName": "CI · Windows · MSVC · RelWithDebInfo",
      "inherits": [ "vs2026-base", "ci-base" ],
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "ci-linux",
      "displayName": "CI · Linux · GCC · RelWithDebInfo",
      "inherits": [ "linux-base", "ci-base" ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "ci-macos",
      "displayName": "CI · macOS · arm64 · RelWithDebInfo",
      "inherits": [ "macos-base", "ci-base" ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },

    {
      "name": "x64-debug",
      "displayName": "x64 Debug   (deprecated → vs2026-x64-debug)",
      "inherits": "vs2026-x64-debug"
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release (deprecated → vs2026-x64-release)",
      "inherits": "vs2026-x64-release"
    },
    {
      "name": "x86-debug",
      "displayName": "x86 Debug   (deprecated → vs2026-x86-debug)",
      "inherits": "vs2026-x86-debug"
    },
    {
      "name": "x86-release",
      "displayName": "x86 Release (deprecated → vs2026-x86-release)",
      "inherits": "vs2026-x86-release"
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug   (deprecated → linux-gcc-debug)",
      "inherits": "linux-gcc-debug"
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug   (deprecated → macos-arm64-debug)",
      "inherits": "macos-arm64-debug"
    }
  ],

